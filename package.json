{
  "name": "heatmap",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --ios",
    "prebuild": "expo prebuild --clean --platform ios",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:dev:ios": "expo run:ios",
    "build:dev:android": "expo run:android",
    "build:release:ios": "expo run:ios --device --configuration Release --no-bundler",
    "build:release:android": "expo run:android --device --variant release",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/metro-runtime": "^6.1.2",
    "@react-native-community/slider": "5.0.1",
    "drizzle-orm": "^0.45.1",
    "expo": "~54.0.38",
    "expo-constants": "^18.0.14",
    "expo-dev-client": "^6.0.21",
    "expo-linking": "^8.0.12",
    "expo-location": "^19.0.8",
    "expo-router": "^6.0.24",
    "expo-sqlite": "^16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-task-manager": "^14.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-maps": "^1.20.1",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "^4.16.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.17",
    "@types/sql.js": "^1.4.11",
    "babel-plugin-inline-import": "^3.0.0",
    "drizzle-kit": "^0.31.10",
    "sql.js": "^1.15.2",
    "typescript": "~5.9.2",
    "vitest": "^5.1.0"
  },
  "private": true,
  "pnpm": {
    "patchedDependencies": {
      "react-native-maps@1.20.1": "patches/react-native-maps@1.20.1.patch"
    }
  }
}
